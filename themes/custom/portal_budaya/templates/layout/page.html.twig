    <section class="hero-section">
    <div class="container hero-inner">

        <div class="hero-content">
        <h1>Surakarta, Kota Dua Keraton, Batik, dan Wayang</h1>

        <p>
            Telusuri tradisi, tokoh, artefak, dan arsip dari Solo.
            Pencarian membaca judul, metadata, dan nama lain,
            sehingga "Solo" dan "Sala" menemukan hasil yang sama.
        </p>

        <div class="hero-search">
            {{ page.hero_search }}
        </div>

        <div class="search-suggestions">
            <span>Coba cari:</span>
            <a href="/search/node?keys=keraton">keraton</a>
            <a href="/search/node?keys=batik">batik</a>
            <a href="/search/node?keys=wayang">wayang</a>
            <a href="/search/node?keys=sekaten">sekaten</a>
        </div>
        </div>

        <div class="hero-logo">
        <img
            src="{{ directory }}/images/logo-surakarta.png"
            alt="Lambang Kota Surakarta"
        >
        <span>Lambang Kota Surakarta</span>
        </div>

    </div>
    </section>


