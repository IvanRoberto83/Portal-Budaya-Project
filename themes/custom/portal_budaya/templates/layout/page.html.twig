        <section class="about-surakarta">
        <div class="container about-grid">

            <div class="about-map">
            <img
                src="{{ directory }}/images/peta-surakarta.png"
                alt="Ilustrasi peta Pulau Jawa dengan penanda lokasi Surakarta"
            >
            <p class="map-caption">
                Letak Surakarta di Pulau Jawa. Sketsa tidak berskala;
                sekitar 60 km di timur laut Yogyakarta.
            </p>
            </div>

            <div class="about-content">
            <h2>Mengenal Surakarta</h2>

            <p class="about-description">
                Surakarta, atau Solo, tumbuh dari desa Sala di tepi Bengawan
                Solo. Pada 1745 Pakubuwono II memindahkan keraton ke sini,
                dan sejak Perjanjian Salatiga (1757) kota ini memiliki dua
                istana: Kasunanan dan Mangkunegaran.
            </p>

            <div class="about-information">

                <div class="about-row">
                <strong>Dua istana</strong>
                <a href="/tempat-bersejarah">Keraton Surakarta, Pura Mangkunegaran</a>
                </div>

                <div class="about-row">
                <strong>Batik</strong>
                <a href="/katalog-tradisi">Kampung Batik Laweyan, Batik Sidomukti</a>
                </div>

                <div class="about-row">
                <strong>Wayang</strong>
                <a href="/seni-pertunjukan">Wayang Orang Sriwedari, Wayang Kulit Purwa</a>
                </div>

                <div class="about-row">
                <strong>Nama Sala dan Solo</strong>
                <a href="/sejarah-peristiwa">Asal Mula Nama Sala dan Solo</a>
                </div>

                <div class="about-row">
                <strong>Sejarah kota</strong>
                <a href="/sejarah-peristiwa">Perjanjian Giyanti, Pakubuwono X</a>
                </div>

            </div>

            <p class="about-footnote">
                Lima kecamatan: Banjarsari, Jebres, Laweyan,
                Pasar Kliwon, dan Serengan.
            </p>
        </div>

    </div>
    </section>

    
